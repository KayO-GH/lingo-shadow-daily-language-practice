# Copy this file to .env and fill in real values.

# Hugging Face token used for Qwen sentence generation.
HF_TOKEN=hf_your_huggingface_token_here

# Modal-backed French TTS endpoint base URL, for example:
# https://your-workspace--daily-language-practice-tts-fastapi-app.modal.run
MODAL_TTS_BASE_URL=https://your-modal-tts-endpoint-here

# Bearer token sent by the app to the Modal TTS service.
MODAL_TTS_AUTH_TOKEN=your_modal_tts_bearer_token_here

# Optional timeout override for Modal TTS requests in seconds.
MODAL_TTS_TIMEOUT_SECONDS=120
